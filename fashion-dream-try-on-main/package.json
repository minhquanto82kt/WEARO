{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "npm@11",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "deploy:cloudflare": "npm run build && npx wrangler deploy",
    "cf-typegen": "npx wrangler types",
    "lint": "eslint . --rule 'prettier/prettier: off' --rule 'no-empty: off' --rule 'no-useless-escape: off' --rule 'no-extra-boolean-cast: off'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test:smoke": "node tests/smoke/routes.mjs",
    "test:phase-b-c": "node tests/smoke/phase-b-c-invariants.mjs",
    "test:phase-d-e": "node tests/smoke/phase-d-e-invariants.mjs",
    "test:phase-f-security": "node tests/security/phase-f-security.mjs",
    "test:replicate-provider": "node tests/smoke/replicate-provider-invariants.mjs",
    "test:customer-experience": "node tests/smoke/customer-experience.mjs",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "test:customer-flows": "node tests/smoke/customer-commerce-flows.mjs",
    "check:env": "node scripts/backend/check-env.mjs",
    "check:env:preview": "node scripts/backend/check-env.mjs --profile=preview",
    "check:env:production": "node scripts/backend/check-env.mjs --profile=production",
    "audit:api-security": "node scripts/backend/audit-api-security.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1",
    "undici": "7.30.1",
    "zod": "$zod",
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.100",
    "@assistant-ui/ai-sdk": "^0.0.4",
    "@assistant-ui/react": "^0.15.18",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "@vercel/flags-core": "^1.8.1",
    "ai": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.0",
