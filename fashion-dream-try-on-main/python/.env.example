# Python/FastAPI runtime. Keep these values server-side only.
SUPABASE_URL=
# Same Supabase service-role secret as root SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Private Supabase Storage bucket used for uploaded and generated Try-On images.
STORAGE_BUCKET=try-on-assets

# Keep "stub" for local development. Production needs a real configured provider.
# Hosted FASHN: TRY_ON_PROVIDER=fashn + FASHN_API_KEY.
# Replicate: TRY_ON_PROVIDER=replicate + REPLICATE_API_TOKEN + REPLICATE_TRYON_MODEL (owner/model).
# Default Replicate inputs target models using human_img, garm_img, category and garment_des.
# Override input field names below if the selected model uses a different schema.
# Self-hosted FASHN VTON: TRY_ON_PROVIDER=fashn-local + LOCAL_TRYON_API_URL + LOCAL_TRYON_API_KEY.
TRY_ON_PROVIDER=stub
FASHN_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_TRYON_MODEL=
REPLICATE_TRYON_PERSON_IMAGE_FIELD=human_img
REPLICATE_TRYON_GARMENT_IMAGE_FIELD=garm_img
REPLICATE_TRYON_CATEGORY_FIELD=category
REPLICATE_TRYON_DESCRIPTION_FIELD=garment_des
LOCAL_TRYON_API_URL=
LOCAL_TRYON_API_KEY=

# Required to authorize /api/try-on/internal/worker/reconcile and /worker/metrics.
# Configure the same random secret as CRON_SECRET in Vercel.
CRON_SECRET=

GEMINI_API_KEY=
GEMINI_PRODUCT_VISION_MODEL=gemini-3.8-flash
