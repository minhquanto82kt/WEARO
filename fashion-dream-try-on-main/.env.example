# Public site URL used for SEO canonical URLs and absolute sitemap URLs.
# Example: https://wearo.vn
VITE_SITE_URL=
PUBLIC_APP_URL=

# Supabase server. Never prefix secrets with VITE_.
SUPABASE_URL=
# Required by the TanStack server-side bridge for Try-On and Stylist.
# Use the same service-role secret in python/.env as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# AI Try-On backend settings (Python/FastAPI also runs on Vercel).
# Set these in Vercel Production/Preview as appropriate; do not commit real values.
# Python must receive SUPABASE_SERVICE_ROLE_KEY with the same value as SUPABASE_SECRET_KEY.
# Set STORAGE_BUCKET=try-on-assets (private bucket) and CRON_SECRET to a random secret.
# Set TRY_ON_PROVIDER=fashn and FASHN_API_KEY for hosted FASHN.
# The default TRY_ON_PROVIDER=stub intentionally disables real Try-On processing.

# Account UX preview
# Enable only in Vercel Preview/Development. Keep disabled in Production.
VITE_ACCOUNT_PREVIEW_BYPASS=false

# Vercel Flags admin control
# Server-only token. Never expose as a VITE_* variable.
VERCEL_ACCESS_TOKEN=

# MoMo Payment Gateway
# Use the test endpoint for sandbox integration first.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_NAME=Fashion Dream Try-On Shop
MOMO_STORE_ID=FashionDreamTryOn
MOMO_REDIRECT_URL=https://your-domain.example/checkout
MOMO_IPN_URL=https://your-domain.example/api/momo/ipn

# Mastercard Gateway Hosted Checkout
# Keep every value server-side. Never prefix these with VITE_.
MASTERCARD_MERCHANT_ID=
MASTERCARD_API_PASSWORD=
MASTERCARD_GATEWAY_URL=https://ap.gateway.mastercard.com
MASTERCARD_API_VERSION=100
